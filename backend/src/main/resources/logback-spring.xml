<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 自定义配置：不使用 Spring Boot 默认 base.xml（其 FILE appender 与本配置冲突） -->
    <!-- CONSOLE 格式：加入 requestId -->
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="teaching-system"/>
    <appender name="CONSOLE_WITH_REQUEST_ID" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{requestId:-}] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 覆盖默认 FILE 格式：加入 requestId -->
    <appender name="FILE_WITH_REQUEST_ID" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/${APP_NAME}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/${APP_NAME}.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] [%X{requestId:-}] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- API 访问日志独立文件（JSON 单行格式，便于 ELK/Loki 采集） -->
    <appender name="API_LOG" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/api.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/api.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <!-- ApiLogAspect 已输出完整 JSON，此处仅用 %msg 原样写入 -->
            <pattern>%msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <immediateFlush>false</immediateFlush>
    </appender>

    <!-- ApiLogAspect 日志仅输出到 API_LOG 文件，不重复打印到 console / teaching-system.log -->
    <logger name="com.school.teaching.aspect.ApiLogAspect" level="INFO" additivity="false">
        <appender-ref ref="API_LOG"/>
    </logger>

    <!-- 监控指标定时采集日志（独立文件，避免与业务日志混合） -->
    <appender name="MONITOR_LOG" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/monitor.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/monitor.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>90</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <immediateFlush>false</immediateFlush>
    </appender>

    <!-- MonitorLogger 使用独立名称（非类全名），仅输出到 MONITOR_LOG -->
    <logger name="MonitorLogger" level="INFO" additivity="false">
        <appender-ref ref="MONITOR_LOG"/>
    </logger>

    <!-- 覆盖 Spring Boot 默认 root logger：使用带 requestId 的 appender -->
    <root level="INFO">
        <appender-ref ref="CONSOLE_WITH_REQUEST_ID"/>
        <appender-ref ref="FILE_WITH_REQUEST_ID"/>
    </root>
</configuration>
