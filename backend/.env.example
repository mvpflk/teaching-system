# ============================================
# 教学管理系统 — 生产环境变量模板
# 复制为 .env 并填入实际值，启动时 source .env
# ============================================

# --- 必填 ---
DB_URL=jdbc:mysql://your-db-host:3306/teaching_system?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=teaching_user
DB_PASSWORD=your-db-password

# JWT密钥（至少32字符，随机生成：openssl rand -base64 32）
JWT_SECRET=your-256-bit-secret-key-change-me

# CORS允许的前端域名（生产环境改为实际域名）
CORS_ORIGINS=https://your-domain.com

# --- 可选 ---
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# MYSQLDUMP_PATH=/usr/bin/mysqldump
# JWT_EXPIRATION=86400000
# DB_APP_PASSWORD=
# DB_POOL_SIZE=20
# UPLOAD_MAX_SIZE=20MB
# UPLOAD_MAX_REQUEST=50MB
# SERVER_PORT=8080
