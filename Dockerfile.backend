# ★ 简化镜像构建：仅安装 JRE + 复制 JAR，首次 docker-compose build 后不再重建
# 后续部署通过 docker cp + docker restart 完成（~5s vs 120s Docker build）
FROM eclipse-temurin:17-jre-alpine
RUN apk add --no-cache tzdata curl
ENV TZ=Asia/Shanghai
WORKDIR /app
# 初始 JAR（仅用于 docker-compose build 首次创建镜像）
COPY backend/target/*.jar app.jar
EXPOSE 8080
# R112: 降低JVM堆大小（2核4G服务器需为MySQL/Redis/Nginx留足内存）
ENTRYPOINT ["java", "-Xms256m", "-Xmx1024m", "-XX:MaxMetaspaceSize=256m", "-XX:+UseG1GC", "-XX:MaxGCPauseMillis=200", "-XX:GCTimeRatio=9", "-Duser.timezone=Asia/Shanghai", "-jar", "app.jar", "--spring.profiles.active=prod"]
