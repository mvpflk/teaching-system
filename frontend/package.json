{
  "name": "teaching-system-frontend",
  "version": "1.0.0",
  "description": "职高计算机教学管理系统 - 前端",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .eslintignore",
    "lint:check": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --ignore-path .eslintignore",
    "lint:report": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --ignore-path .eslintignore -f stylish -o eslint-report.txt",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "unused:components": "node scripts/find-unused-components.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@vant/auto-import-resolver": "^1.3.0",
    "axios": "^1.6.5",
    "canvas-confetti": "^1.9.4",
    "dayjs": "^1.11.10",
    "dompurify": "^3.4.5",
    "echarts": "^5.6.0",
    "element-plus": "^2.5.4",
    "html2canvas": "^1.4.1",
    "js-cookie": "^3.0.5",
    "jspdf": "^4.2.1",
    "katex": "^0.16.47",
    "marked": "^18.0.4",
    "nprogress": "^0.2.0",
    "pinia": "^2.1.7",
    "prismjs": "^1.29.0",
    "puppeteer-core": "^24.42.0",
    "vant": "^4.9.24",
    "vue": "^3.4.15",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^5.0.3",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^8.56.0",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^9.20.1",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.4",
    "rollup-plugin-visualizer": "^7.0.1",
    "sass": "^1.70.0",
    "unplugin-auto-import": "^0.17.3",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^5.0.12",
    "vite-plugin-vue-inspector": "^4.0.2",
    "vitest": "^4.1.9"
  }
}
